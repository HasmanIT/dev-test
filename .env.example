# Names only. Never commit real values.

# --- Browser (GitHub repo variables, and web/.env.local for local dev) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Supabase Edge Function secrets (supabase secrets set ..., or supabase/functions/.env locally) ---
# The service-role key, SUPABASE_URL and SUPABASE_ANON_KEY are provided to functions by Supabase automatically.
OPENAI_API_KEY=
GRADER_MODEL=
# Comma-separated browser origins allowed to call the functions, e.g. https://your-org.github.io
ALLOWED_ORIGINS=
# Local development only: also allow http://localhost:5173 and :4173
ALLOW_LOCALHOST=
